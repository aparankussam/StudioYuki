# Studio Yuki Arts — Environment Variables
#
# Copy to .env.local and fill in for local dev. In production, set these in
# Vercel Project Settings → Environment Variables.

# Admin login (HTTP Basic Auth on /admin)
ADMIN_USER=yuki
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Vercel Blob — auto-injected by Vercel when you connect a Blob store to the project.
# Locally: copy this from Vercel dashboard if you want to test against production storage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
